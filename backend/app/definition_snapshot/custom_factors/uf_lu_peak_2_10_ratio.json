{
  "id": "uf_lu_peak_2_10_ratio",
  "label": "历史2至10日事件收盘/当前收盘最大比（无事件0）",
  "formula": "ts_delay(ts_max(if_else(strict_close_limit == 1, close, 0), 9), 2) / close",
  "kind": "custom",
  "status": "active",
  "lang": "dsl",
  "version": 1,
  "group": "日线信号特征",
  "direction": "none",
  "data_contract": {
    "version": 2,
    "inputs": {
      "open": 11,
      "high": 11,
      "low": 11,
      "close": 11,
      "strict_close_limit": 9
    },
    "ohlc_window": 11,
    "offsets": {
      "strict_close_limit": 2
    }
  }
}
