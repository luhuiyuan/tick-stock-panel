{
  "id": "uf_lu_peak_1_20_ratio",
  "label": "历史1至20日事件收盘/当前收盘最大比（无事件0）",
  "formula": "ts_delay(ts_max(if_else(strict_close_limit == 1, close, 0), 20), 1) / close",
  "kind": "custom",
  "status": "active",
  "lang": "dsl",
  "version": 1,
  "group": "日线信号特征",
  "direction": "none",
  "data_contract": {
    "version": 2,
    "inputs": {
      "open": 21,
      "high": 21,
      "low": 21,
      "close": 21,
      "strict_close_limit": 20
    },
    "ohlc_window": 21,
    "offsets": {
      "strict_close_limit": 1
    }
  }
}
