@@ -27,3 +27,175 @@ BACKEND_EXTRAS=
 
 # ===== Data =====
 DATA_DIR=./data
+
+# ===== 多源资讯（默认关闭，说明见 docs/news-sources.md） =====
+# 环境变量优先于热门事件页上的开关。留空则关闭，已有部署不会开始出网。
+NEWS_DWS_ENABLED=
+NEWS_ZSXQ_ENABLED=
+NEWS_IMA_ENABLED=
+NEWS_CLS_ENABLED=
+NEWS_WSCN_ENABLED=
+# 格隆汇快讯。公开接口，不需要登录。留空时默认打开，页面可以关。写成 false 则关闭且页面不能改。
+NEWS_GLH_ENABLED=
+NEWS_ETF_FLOW_ENABLED=
+NEWS_CNBC_ENABLED=
+NEWS_MARKETWATCH_ENABLED=
+NEWS_WSJ_ENABLED=
+NEWS_BLOOMBERG_ENABLED=
+NEWS_SCMP_ENABLED=
+NEWS_REUTERS_ENABLED=
+NEWS_REDDIT_ENABLED=
+# 逗号分隔。留空时用 wallstreetbets,stocks,investing。JSON 接口会 403，只拉 /new/.rss。
+# NEWS_REDDIT_SUBREDDITS=wallstreetbets,stocks,investing
+# 预留。当前采集不换 token，请求里也不带 Authorization。
+# REDDIT_CLIENT_ID=
+# REDDIT_CLIENT_SECRET=
+NEWS_SEC_ENABLED=
+# SEC 最新 8-K。User-Agent 必须包含联系邮箱，否则来源保持未配置、不会出网。
+# 值里有空格，必须加引号，否则邮箱会被截掉。
+# SEC_USER_AGENT="TSP-News ops@example.com"
+# NEWS_LLM_EXTRACT=false
+# ETF领航者申赎表格的视觉模型。和上面的 AI_API_KEY / AI_BASE_URL / AI_MODEL 分开。
+# 没填 VISION_AI_API_KEY 时，这个来源保持未配置。
+# 不要复用 AI_API_KEY。默认模型会读图片。
+# 申赎表格保持思考，max_tokens 为 8192；关掉思考会让表格识别变差。
+# 备选：glm-5.3-flash、mimo-v2.6-flash。不把备选写成默认。
+# VISION_AI_API_KEY=
+# VISION_AI_BASE_URL=https://tokenhub.tencentmaas.com/v1
+# VISION_AI_MODEL=deepseek/deepseek-v4-flash-vision-exp
+# 钉钉群号、知识星球号。留空表示未配置，对应来源无法开启。
+# NEWS_DWS_GROUP_ID=
+# 知识星球可以只填一个星球号，和以前一样。
+# 多个星球用英文逗号或中文逗号分隔，这里只写星球号、不写名称。
+# NEWS_ZSXQ_GROUP_ID=1001,1002
+# 要在热点和推送里标出星球时，用「星球号:名称」，同样用逗号分隔。
+# 冒号可以用英文或中文。这一项只要非空，就不再读上面的 NEWS_ZSXQ_GROUP_ID。
+# 名称会出现在来源名里，例如「知识星球·每日投研」。
+# NEWS_ZSXQ_GROUPS=1001:纳指星球调研,1002:每日投研
+# 帖子里的 PDF 研报会下载进研报库，来源写成「知识星球·星球名」。留空默认开，false 才关。
+# 只下载 .pdf，mp3 / xlsx 只把元数据留在收件箱。单文件默认 30MB，每轮 8 个，间隔 1 秒。
+# 已抽取的 PDF 默认留 60 天、总量 2048MB。DELETE_AFTER=true 时正文入库后立刻删文件。
+# NEWS_ZSXQ_FILES_ENABLED=
+# NEWS_ZSXQ_FILES_MAX_MB=30
+# NEWS_ZSXQ_FILES_PER_ROUND=8
+# NEWS_ZSXQ_FILES_GAP_MS=1000
+# NEWS_ZSXQ_FILES_KEEP_DAYS=60
+# NEWS_ZSXQ_FILES_MAX_TOTAL_MB=2048
+# NEWS_ZSXQ_FILES_DELETE_AFTER=false
+# 扫描版 PDF 的 OCR 每轮最多几份，默认 5。写成 0 则关闭。北京时间 09:15–15:05 不跑。
+# 系统包：poppler-utils、tesseract-ocr、tesseract-ocr-eng、tesseract-ocr-chi-sim。
+# Python 包：pypdf、pdfminer.six。没有 tesseract 时可选 rapidocr-onnxruntime。
+# NEWS_ZSXQ_OCR_MAX_PER_ROUND=5
+# IMA_CLIENT_ID=
+# IMA_API_KEY=
+# IMA_KB_ID=
+# 个人知识库「莽的知识库」的券商研报全文。ID 不要写进代码。留空则这条来源未配置。
+# 用户每天 0:30 开始转存前一天的稿，所以默认 06:30 和 08:30 各拉一次。
+# IMA_RESEARCH_KB_ID=ak-X2lYob-kG7ynbrrHCsGUY4g6kjGEW1R10JlE24lo=
+# IMA_RESEARCH_TIMES=06:30,08:30
+# NEWS_IMA_RESEARCH_ENABLED=false
+# 登录失效提醒，以及热门事件页的候选推送，共用这一个自定义机器人。两条路径文案分开。
+# DINGTALK_WEBHOOK_URL=
+# DINGTALK_SECRET=
+# 推送默认全关。总开关和对应类型都要打开才会发。时间是北京时间，只在交易日。
+# NEWS_PUSH_ENABLED=false
+# NEWS_PUSH_HOT_ENABLED=false
+# NEWS_PUSH_ABNORMAL_ENABLED=false
+# NEWS_PUSH_T_ENABLED=false
+# NEWS_PUSH_PREMARKET=08:45
+# NEWS_PUSH_POSTCLOSE=15:40
+# NEWS_PUSH_TOP_N=5
+# NEWS_PUSH_MIN_STORIES=2
+# NEWS_PUSH_SCORE_JUMP=0.5
+# 异动是否把热门个股并入自选。做T默认只看自选，下面打开后才把模拟持仓并进去。
+# NEWS_PUSH_ABNORMAL_INCLUDE_HOT=false
+# NEWS_PUSH_T_INCLUDE_POSITIONS=false
+# 做T：均价偏离默认 ±1.5%，贴近高低 0.3%。均价和回到昨收的冷却默认 60 分钟。
+# 贴近高低单独冷却，默认也是 60 分钟。打开下面这项后，这两条合计每只股票每天最多一条。
+# 10:00 之前不推贴近高低。全自选当天做T消息默认最多 20 条，0 表示不限制。
+# NEWS_PUSH_T_COOLDOWN_MIN=60
+# NEWS_PUSH_T_RANGE_COOLDOWN_MIN=60
+# NEWS_PUSH_T_RANGE_ONCE_PER_DAY=false
+# NEWS_PUSH_T_DAILY_CAP=20
+# DSA 拉取 /api/news/dsa-feed 的令牌。至少 32 字节随机串，只放请求头 X-News-Feed-Token，不要放进 URL。
+# 留空则情报桥不工作，DSA 仍可启动。
+# 本地默认 http://127.0.0.1:3018；Docker compose 的 dsa 服务固定为 http://app:3018。
+# NEWS_DSA_FEED_TOKEN=
+# TSP_NEWS_BASE_URL=http://127.0.0.1:3018
+# 妙想补全当日榜首热点。只用 MX_APIKEY，不占用资金流的 FUND_FLOW_MX_MAX_CALLS。
+# 新热点第一次冲上榜首、且这个事件当天还没查过时，才调 claw/news-search。
+# 结果按交易日和事件 key 缓存在 data/news/mx_hot/。每日预算按北京时间自然日计算，
+# 默认 25 次（免费档一共 50 次，剩下的留给以后的个股详情）。
+# 超时、失败或额度用尽时事件保持原样。未设置时默认开启；写成 false 会锁定关闭，设置页不能再改。
+# NEWS_MX_HOT_ENABLED=true
+# NEWS_MX_HOT_DAILY_BUDGET=25
+
+# ===== A 股资金进出 =====
+# 代码默认关闭：下面这些变量不出现在进程环境里时，不调度、不出网。
+# 本 HK 部署按源探测结果打开。个股用显式 secid 请求东财 push2his 日频账单，
+# 不再走 efinance 的代码搜索。逐只请求失败或熔断后，已拿到的行照常落盘；
+# 还没请求的代码改走同花顺全市场排名（stock_fund_flow_individual），
+# 不行再用东财 stock_individual_fund_flow_rank。这两份只补当日和 5 日合计。
+# 不用逐只的 ak.stock_individual_fund_flow / stock_main_fund_flow，也不用东财 push2 板块接口。
+# 开关在非交易日或收盘前提前打开时，会补最近一个还没落盘的交易日。
+# 北向净流入自 2024-08-16 起没有数据，这里只开成交额。
+FUND_FLOW_ENABLED=true
+FUND_FLOW_STOCK=true
+# 盘中个股主力净流入。总开关打开且本变量未设置时默认开启。
+# 交易日连续竞价（北京时间 9:30–11:30、13:00–15:00）每 6 分钟拉一次。
+# 默认东财 stock_individual_fund_flow_rank(indicator=今日)，净额已是元。
+# 失败、空表或不足 1000 行时改同花顺即时「净额」。写成 ths 则只走同花顺。
+# 东财分页加 1 秒限流大约要一分多钟，放在旁路线程，不挡住其它资金任务。
+# 午休、收盘后、周末不拉，也不补历史。写成 false 才关闭。
+FUND_FLOW_STOCK_INTRADAY=true
+# FUND_FLOW_INTRADAY_PRIMARY=eastmoney
+FUND_FLOW_SECTOR=true
+FUND_FLOW_MARGIN=true
+FUND_FLOW_ETF_SHARES=true
+FUND_FLOW_SOUTHBOUND=true
+FUND_FLOW_NORTHBOUND_TURNOVER=true
+FUND_FLOW_LHB_BACKUP=true
+# 妙想只补已经请求过、但东财没有返回的代码。熔断后还没轮到的代码不进妙想。
+# 留空则跳过，不消耗配额。单轮调用上限默认 30。
+# 接口如果返回剩余次数，用这个剩余次数继续判断；同时仍受上面的单轮上限约束。
+# 热点榜首补全用同一把 MX_APIKEY，次数走 NEWS_MX_HOT_DAILY_BUDGET，不看这里的单轮上限。
+# MX_APIKEY=
+# FUND_FLOW_MX_MAX_CALLS=30
+
+# ===== 打板与研报 =====
+# 代码默认打开：环境变量不出现时也会拉数。设为 false 才关闭。
+# 东财涨停/炸板/跌停/昨日涨停池和研报列表共用一把限流，默认至少间隔 1 秒。
+# EASTMONEY_MIN_INTERVAL 低于 0.5 时仍按 0.5，也就是最快 2 次/秒。
+# 连续失败或 HTTP 403 会熔断约 10 分钟。不下载 PDF。
+# 同花顺涨停揭秘先探活。本机在海外时探不到就跳过，东财池子照常落盘。
+# NEWS_RESEARCH_ENABLED 锁住热门事件里的「研报」来源。true 时写入资讯库，false 时只落盘不进热门事件。
+LIMIT_BOARD_ENABLED=true
+LIMIT_BOARD_EASTMONEY=true
+LIMIT_BOARD_THS=true
+RESEARCH_ENABLED=true
+RESEARCH_STOCK=true
+RESEARCH_INDUSTRY=true
+EASTMONEY_MIN_INTERVAL=1.0
+NEWS_RESEARCH_ENABLED=true
+# 每轮只同步一批个股，避免和收盘快照抢东财配额。行业列表默认只回溯 14 天。
+# RESEARCH_BATCH_SIZE=8
+# RESEARCH_MAX_SYMBOLS=40
+
+# ===== 个股事件上下文 =====
+# 龙虎榜明细、两融个股明细、互动易/e互动、全市场公告、盘口异动。
+# 代码默认关闭：这些变量不出现在进程环境里时，不调度、不出网。
+# 总开关关闭时，下面的子开关不生效。
+# 给 DSA 个股分析和热门事件确认用。底层东财请求走统一限速，只包住这个线程。
+# 连接超时 10 秒，读取超时 30 秒。每个子任务有整体超时；超时后不再开第二个线程。
+# 某一项拉空或失败时，保留上次成功的分区，并在热门事件健康页标注。
+# 龙虎榜约 17:40 拉当天明细（净买额、营业部）。两融约 20:10，或次日开盘前补上一交易日。
+# 东财当天没有深市时改读深交所明细；深交所也没有则只写沪市并标注。
+# 互动问答只拉自选和热门事件相关个股，每次几只，增量。公告增量落在事件上下文，个股分析直接读。
+# 业绩预告、重组、回购、增减持、立案每次最多 40 条进入热门事件。不再使用返回 0 条的巨潮接口。
+# 盘口异动在 9:35–15:00 约 10 分钟拉一次。
+EVENT_CONTEXT_ENABLED=true
+EVENT_CONTEXT_LHB=true
+EVENT_CONTEXT_MARGIN=true
+EVENT_CONTEXT_QA=true
+EVENT_CONTEXT_NOTICE=true
+EVENT_CONTEXT_CHANGES=true
